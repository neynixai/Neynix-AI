---
import type { GetStaticPaths } from "astro";
import { getImage, Image } from "astro:assets";
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ButtonLink from "@/components/ButtonLink.astro";
import PointCards from "@/components/PointCards.astro";
import PricingPlans from "@/components/PricingPlans.astro";
import ProjectSection from "@/components/ProjectSection.astro";
import ProjectStatusBadge from "@/components/ProjectStatusBadge.astro";
import ProjectTags from "@/components/ProjectTags.astro";
import ScreenSlideshow from "@/components/ScreenSlideshow.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { href } from "@/lib/paths";
import { projects, statuses, type Project } from "@/lib/projects";

// Static build: every project in src/lib/projects.ts gets a page.
export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

type Props = { project: Project };

const { project } = Astro.props;
const path = `/work/${project.slug}/`;
const title = `${project.title} | ${siteConfig.name}`;

// Social preview: the screenshot cropped to the 1200×630 card size.
const ogImage = await getImage({
  src: project.image,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "left top",
  format: "jpg",
});

const pageUrl = siteConfig.url ? `${siteConfig.url}${path}` : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CreativeWork",
      name: project.title,
      headline: project.tagline,
      description: project.description,
      keywords: project.tags.join(", "),
      genre: project.category,
      creativeWorkStatus: statuses[project.status].label,
      inLanguage: "en",
      ...(pageUrl
        ? { url: pageUrl, image: `${new URL(siteConfig.url).origin}${ogImage.src}`, mainEntityOfPage: pageUrl }
        : {}),
      creator: siteConfig.url
        ? { "@id": `${siteConfig.url}/#organization` }
        : { "@type": "Organization", name: siteConfig.name },
    },
    ...(pageUrl
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: siteConfig.name, item: `${siteConfig.url}/` },
              { "@type": "ListItem", position: 2, name: project.title, item: pageUrl },
            ],
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={title}
  description={project.description}
  keywords={project.tags}
  tags={project.tags}
  path={path}
  type="article"
  image={{ src: ogImage.src, alt: project.imageAlt, width: 1200, height: 630 }}
  structuredData={structuredData}
>
  <div id="top"></div>
  <SiteHeader />
  <main id="main">
    <article>
      <header class="container-page pb-10 pt-10 sm:pt-14 lg:pb-16">
        <a
          href={href("/#work")}
          class="inline-flex items-center gap-2 text-sm font-medium text-grey transition-colors hover:text-offwhite"
        >
          <ArrowLeft aria-hidden="true" class="size-4" stroke-width={1.75} />
          All work
        </a>

        <div class="mt-10 grid items-center gap-12 lg:mt-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
          <div>
            <p class="eyebrow flex items-center gap-2.5 text-lime animate-rise">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-lime"></span>
              {project.category}
            </p>
            <h1 class="mt-5 text-display animate-rise [animation-delay:80ms]">{project.title}</h1>
            <p class="mt-6 text-lede text-pretty text-grey animate-rise [animation-delay:160ms]">
              {project.tagline}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3 animate-rise [animation-delay:200ms]">
              {
                project.liveUrl && (
                  <ButtonLink href={project.liveUrl} target="_blank" rel="noopener">
                    Try it live
                    <ArrowUpRight
                      aria-hidden="true"
                      class="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      stroke-width={1.75}
                    />
                    <span class="sr-only">(opens in a new tab)</span>
                  </ButtonLink>
                )
              }
              <ButtonLink href="/#contact" variant={project.liveUrl ? "secondary" : "primary"} arrow>
                Discuss a project like this
              </ButtonLink>
              {project.screens && <ButtonLink href="#screens" variant="secondary">See the screens</ButtonLink>}
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-3 animate-rise [animation-delay:240ms]">
              <ProjectStatusBadge status={project.status} />
              <ProjectTags tags={project.tags} />
            </div>
          </div>

          <div
            data-tilt="3"
            class="group relative aspect-[16/10] overflow-hidden rounded-xl border border-line bg-elevated shadow-[0_40px_120px_-40px_rgb(215_255_100/0.18)] will-change-transform animate-fade [animation-delay:300ms]"
          >
            <Image
              src={project.image}
              alt={project.imageAlt}
              widths={[640, 960, 1360, 1920]}
              sizes="(min-width: 1216px) 640px, (min-width: 1024px) 55vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="absolute inset-0 size-full object-cover object-left-top"
            />
          </div>
        </div>
      </header>

      <ProjectSection id="why" eyebrow="Why it exists" title="The problem" lede={project.why.intro}>
        <PointCards points={project.why.points} columns={3} steps />
      </ProjectSection>

      <ProjectSection id="what" eyebrow="What it is" title={`What ${project.title} does`} lede={project.what.intro}>
        {
          project.screens && (
            <div id="screens" class="mb-16 scroll-mt-24">
              <ScreenSlideshow screens={project.screens} label={`${project.title} screens`} />
            </div>
          )
        }
        <PointCards points={project.what.features} columns={3} />
      </ProjectSection>

      <ProjectSection id="how" eyebrow="How it’s built" title="The principles behind it">
        <PointCards points={project.principles} columns={4} />
      </ProjectSection>

      <ProjectSection id="who" eyebrow="Who it’s for" title="Built for">
        <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            project.audiences.map((audience) => (
              <li class="reveal">
                <h3 class="flex items-center gap-2.5 text-base">
                  <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-lime" />
                  {audience.title}
                </h3>
                <p class="mt-3 text-body text-grey">{audience.body}</p>
              </li>
            ))
          }
        </ul>
      </ProjectSection>

      {
        project.pricing && (
          <ProjectSection id="pricing" eyebrow="Pricing" title="Plans" lede={project.pricing.intro}>
            <PricingPlans plans={project.pricing.plans} />
            {project.pricing.note && <p class="mt-6 max-w-2xl text-sm text-grey">{project.pricing.note}</p>}
          </ProjectSection>
        )
      }

      <ProjectSection id="progress" eyebrow="Where it stands" title="Today and next">
        <div class="reveal grid gap-10 rounded-2xl border border-line-strong bg-[linear-gradient(135deg,rgb(215_255_100/0.06),transparent_45%)] bg-elevated p-7 sm:p-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-14">
          <div>
            <ProjectStatusBadge status={project.status} />
            <p class="mt-6 text-lede text-pretty text-offwhite/85">{project.progress.now}</p>
          </div>
          <div>
            <h3 class="text-base">Coming next</h3>
            <ul class="mt-5 space-y-4">
              {
                project.progress.next.map((item) => (
                  <li class="flex gap-3.5 text-body text-grey">
                    <span aria-hidden="true" class="mt-[0.55em] size-2 shrink-0 rounded-sm bg-lime" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        {project.note && <p class="mt-6 max-w-2xl text-xs text-grey">{project.note}</p>}
      </ProjectSection>

      <section aria-labelledby="project-cta-title" class="section-pad">
        <div class="container-page reveal flex flex-col items-center text-center">
          <p class="eyebrow">Have an idea worth building?</p>
          <h2 id="project-cta-title" class="mt-4 max-w-2xl text-heading">Let&rsquo;s build yours next.</h2>
          <p class="mt-5 max-w-xl text-lede text-pretty text-grey">
            From a first prototype to a product people rely on, {siteConfig.name} turns ideas like this into working
            software.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <ButtonLink href="/#contact" arrow>Discuss a project</ButtonLink>
            <ButtonLink href="/#work" variant="secondary">See all work</ButtonLink>
          </div>
        </div>
      </section>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
