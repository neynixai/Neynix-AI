---
import { markSvg, nextMarkId } from "@/lib/mark";

/** The NEYNIX mark as inline SVG, so it stays sharp at every size. */
type Props = { class?: string; alt?: string };

const { class: className = "", alt = "" } = Astro.props;
const a11y = alt ? `role="img" aria-label="${alt.replace(/"/g, "&quot;")}"` : `aria-hidden="true"`;
---

<Fragment set:html={markSvg(nextMarkId(), `class="${className}" ${a11y}`)} />
