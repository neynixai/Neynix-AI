---
import FileText from "@lucide/astro/icons/file-text";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Users from "@lucide/astro/icons/users";
import ButtonLink from "@/components/ButtonLink.astro";
import ContactForm from "@/components/ContactForm.astro";
import { CONTACT_EMAIL, LINKEDIN_URL, WEB3FORMS_ACCESS_KEY } from "@/config/site";

const formEnabled = Boolean(WEB3FORMS_ACCESS_KEY);

// "Start a conversation" goes to the best channel that is actually configured.
const primary = formEnabled
  ? { href: "#contact-form" }
  : CONTACT_EMAIL
    ? { href: `mailto:${CONTACT_EMAIL}` }
    : LINKEDIN_URL
      ? { href: LINKEDIN_URL, target: "_blank", rel: "noopener noreferrer" }
      : null;
// What a useful first message covers, from the form's own guidance.
const briefPoints = [
  { label: "The problem", icon: FileText },
  { label: "Who it’s for", icon: Users },
  { label: "Any constraints you already know about", icon: ShieldCheck },
];

const showEmailButton = Boolean(CONTACT_EMAIL) && primary?.href !== `mailto:${CONTACT_EMAIL}`;

/** Soft topographic lines — a quiet nod to depth without generic AI imagery. */
const contours = Array.from({ length: 14 }, (_, i) => {
  const y = 250 + i * 18;
  const a = 40 + i * 6;
  return `M0 ${y} C 240 ${y - a}, 420 ${y + a * 0.6}, 640 ${y - a * 0.4} S 1000 ${y - a * 1.2}, 1200 ${y - a * 0.2}`;
});
---

<section id="contact" aria-labelledby="contact-title" class="relative isolate overflow-hidden border-t border-line bg-obsidian">
  <div class="relative">
    {/* A flowing 3D wave; the contour lines show until (or unless) WebGL draws it. */}
    <div
      data-wave-3d
      aria-hidden="true"
      class="group/wave pointer-events-none absolute inset-y-0 right-0 -z-10 w-full opacity-45 lg:w-[64%] lg:opacity-100"
    >
      <svg
        viewBox="0 0 1200 600"
        preserveAspectRatio="xMidYMid slice"
        class="absolute inset-0 size-full transition-opacity duration-700 [mask-image:linear-gradient(to_right,transparent_10%,black_70%)] group-data-[ready]/wave:opacity-0"
        fill="none"
        stroke="#f5f5f0"
      >
        {contours.map((d, i) => <path d={d} stroke-opacity={0.03 + i * 0.006} />)}
      </svg>
      <canvas
        class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [mask-image:linear-gradient(to_right,transparent,black_40%)] group-data-[ready]/wave:opacity-100"
      ></canvas>
    </div>

    <div class="container-page section-pad grid items-center gap-14 lg:min-h-[34rem] lg:grid-cols-[1.2fr_1fr]">
      <div class="reveal">
        <p class="flex items-center gap-4">
          <span aria-hidden="true" class="h-0.5 w-10 bg-lime"></span>
          <span class="eyebrow uppercase tracking-[0.16em]">06 / Contact</span>
        </p>
        <h2 id="contact-title" class="mt-6 text-heading">
          Have an idea worth building?
          <span class="block text-lime">Let&rsquo;s make it real.</span>
        </h2>
        <p class="mt-6 max-w-lg text-lede text-pretty text-grey">
          Have an AI idea, an automation challenge, or a software project in mind? Let&rsquo;s discuss what a practical
          solution could look like.
        </p>

        {
          (primary || showEmailButton) && (
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              {primary && (
                <ButtonLink arrow {...primary}>
                  Start a conversation
                </ButtonLink>
              )}
              {showEmailButton && (
                <ButtonLink variant="secondary" href={`mailto:${CONTACT_EMAIL}`}>
                  Email NEYNIX AI
                </ButtonLink>
              )}
            </div>
          )
        }

        {
          !primary && import.meta.env.DEV && (
            <p class="mt-9 max-w-lg rounded-md border border-dashed border-line-strong p-4 text-small text-grey">
              Dev note (hidden in production): no contact channel is configured. Set{" "}
              <code class="font-mono text-xs">PUBLIC_CONTACT_EMAIL</code>,{" "}
              <code class="font-mono text-xs">PUBLIC_LINKEDIN_URL</code>, or{" "}
              <code class="font-mono text-xs">PUBLIC_WEB3FORMS_ACCESS_KEY</code> in{" "}
              <code class="font-mono text-xs">.env.local</code> — see{" "}
              <code class="font-mono text-xs">.env.example</code>.
            </p>
          )
        }
      </div>
    </div>
  </div>

  {
    formEnabled && (
      <div id="contact-form" class="container-page pb-[clamp(4.5rem,3rem+6vw,8.5rem)]">
        <div class="reveal relative isolate grid gap-10 overflow-hidden rounded-2xl border border-lime/20 bg-[linear-gradient(150deg,#1a1d16_0%,#111310_55%,#151912_100%)] p-7 sm:p-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
          <span aria-hidden="true" class="pointer-events-none absolute -left-24 -top-24 -z-10 size-72 rounded-full bg-lime/[0.08] blur-3xl" />
          <span aria-hidden="true" class="pointer-events-none absolute -bottom-32 -right-24 -z-10 size-80 rounded-full bg-lime/[0.05] blur-3xl" />
          <div>
            <span aria-hidden="true" class="block h-0.5 w-8 bg-lime" />
            <h3 class="mt-6 font-display text-[1.75rem] leading-tight tracking-[-0.02em]">Tell us about your project</h3>
            <p class="mt-3 max-w-sm text-body text-grey">A few sentences is enough. It helps to cover:</p>
            <ul class="mt-7 space-y-3">
              {briefPoints.map(({ label, icon: Icon }) => (
                <li class="flex items-center gap-3 text-small text-offwhite/85">
                  <span class="grid size-8 shrink-0 place-items-center rounded-md border border-lime/40 bg-obsidian/60 text-lime">
                    <Icon aria-hidden="true" class="size-4" stroke-width={1.6} />
                  </span>
                  {label}
                </li>
              ))}
            </ul>
          </div>
          <ContactForm />
        </div>
      </div>
    )
  }
</section>

<script>
  import { mountWave3D } from "@/scripts/wave-3d";

  const root = document.querySelector<HTMLElement>("[data-wave-3d]");
  const canvas = root?.querySelector("canvas");
  if (root && canvas) mountWave3D(canvas, () => root.setAttribute("data-ready", ""));
</script>
