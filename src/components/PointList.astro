---
type Props = { points: { title: string; body: string }[]; columns: 2 | 3 };

const { points, columns } = Astro.props;
---

<ul class:list={["mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2", { "lg:grid-cols-3": columns === 3 }]}>
  {
    points.map((point) => (
      <li class="reveal border-t border-line pt-6">
        <h3 class="text-title">{point.title}</h3>
        <p class="mt-3 text-body text-grey">{point.body}</p>
      </li>
    ))
  }
</ul>
