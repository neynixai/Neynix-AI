---
import ChartLine from "@lucide/astro/icons/chart-line";
import CodeXml from "@lucide/astro/icons/code-xml";
import Layers from "@lucide/astro/icons/layers";
import Users from "@lucide/astro/icons/users";

const reasons = [
  {
    title: "Direct collaboration",
    body: "Work directly with the person designing and building the solution.",
    icon: Users,
  },
  {
    title: "Engineering-first decisions",
    body: "Choose technologies based on the problem rather than trends.",
    icon: CodeXml,
  },
  {
    title: "Practical implementation",
    body: "Focus on useful outcomes rather than impressive demos alone.",
    icon: Layers,
  },
  {
    title: "Designed to evolve",
    body: "Favor maintainable code, clear architecture, and measurable behavior.",
    icon: ChartLine,
  },
];
---

<section aria-labelledby="why-title" class="section-pad border-t border-line bg-obsidian">
  <div class="container-page">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">Why NEYNIX AI</p>
        <h2 id="why-title" class="mt-4 max-w-3xl text-heading">Independent by design. Ambitious by nature.</h2>
      </div>
      <p aria-hidden="true" class="eyebrow hidden shrink-0 md:block">05 — Why NEYNIX</p>
    </div>

    <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        reasons.map(({ title, body, icon: Icon }) => (
          <li class="reveal flex gap-4 lg:flex-col">
            <Icon aria-hidden="true" class="mt-0.5 size-6 shrink-0" stroke-width={1.4} />
            <div>
              <h3 class="text-title">{title}</h3>
              <p class="mt-2 text-body text-grey">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
