---
import LogoMark from "@/components/LogoMark.astro";

/** Mark + wordmark lockup used in the navigation and footer. */
type Props = { class?: string };

const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <LogoMark class="h-[22px] w-auto" />
  <span class="font-display text-[0.9rem] font-medium tracking-[0.2em] text-offwhite">
    NEYNIX<span class="text-grey">{" "}AI</span>
  </span>
</span>
