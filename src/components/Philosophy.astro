---
import Box from "@lucide/astro/icons/box";
import Brain from "@lucide/astro/icons/brain";
import ChartColumnIncreasing from "@lucide/astro/icons/chart-column-increasing";
import ChartNoAxesColumn from "@lucide/astro/icons/chart-no-axes-column";
import Database from "@lucide/astro/icons/database";
import FileText from "@lucide/astro/icons/file-text";
import Layers from "@lucide/astro/icons/layers";
import LayoutGrid from "@lucide/astro/icons/layout-grid";
import Network from "@lucide/astro/icons/network";
import SectionHeader from "@/components/SectionHeader.astro";

const flow = [
  { label: "Data", caption: "Your documents, systems, and data.", icon: Database },
  { label: "Context", caption: "Relevant information through retrieval and structured data.", icon: FileText },
  { label: "Reasoning", caption: "LLMs and agentic workflows.", icon: Brain, focus: true },
  { label: "Tools", caption: "APIs, databases, and integrated systems.", icon: LayoutGrid },
  { label: "Outcome", caption: "Useful, actionable results in your workflow.", icon: ChartColumnIncreasing },
];

const principles = [
  {
    id: "context",
    title: "Context",
    body: "Ground responses in relevant documents, structured data, and retrieval.",
    icon: Layers,
  },
  {
    id: "orchestration",
    title: "Orchestration",
    body: "Coordinate models, tools, APIs, and databases through controlled workflows.",
    icon: Network,
  },
  {
    id: "evaluation",
    title: "Evaluation",
    body: "Trace execution, test outputs, and measure system behavior.",
    icon: ChartNoAxesColumn,
  },
  {
    id: "integration",
    title: "Integration",
    body: "Connect intelligent applications to existing software and business workflows.",
    icon: Box,
  },
];

const rhombus = (y: number) => `90,${y} 170,${y + 40} 90,${y + 80} 10,${y + 40}`;
---

<section aria-labelledby="philosophy-title" class="section-pad relative overflow-hidden bg-obsidian">
  <div aria-hidden="true" class="pointer-events-none absolute -left-40 top-1/2 size-[30rem] rounded-full bg-lime/[0.04] blur-3xl"></div>

  <div class="container-page relative">
    <SectionHeader
      id="philosophy-title"
      eyebrow="How we think"
      index="02 / Philosophy"
      title="More than a model call."
      lede="Useful AI takes more than an API connection. It needs reliable data, relevant context, orchestration, evaluation, and integration into real workflows."
    />

    <figure class="reveal relative mt-16">
      <ol class="relative grid gap-0 md:grid-cols-5 md:gap-4">
        {/* Connector — vertical on mobile. */}
        <div aria-hidden="true" class="absolute inset-y-7 left-7 w-px bg-line-strong md:hidden">
          <span class="motion-pulse absolute left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-lime animate-travel-y"></span>
        </div>
        {/* Connector — horizontal on desktop, with a lime node between each step. */}
        <div aria-hidden="true" class="absolute inset-x-[10%] top-9 hidden h-px bg-gradient-to-r from-line-strong via-lime/40 to-line-strong md:block">
          {[12.5, 37.5, 62.5, 87.5].map((left) => (
            <span
              class="absolute top-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-lime shadow-[0_0_10px_rgba(215,255,100,0.8)]"
              style={`left: ${left}%`}
            />
          ))}
        </div>

        {
          flow.map(({ label, caption, icon: Icon, focus }, i) => (
            <li class="relative flex gap-5 py-4 md:flex-col md:items-center md:py-0 md:text-center">
              <span
                class:list={[
                  "relative flex size-14 shrink-0 items-center justify-center rounded-xl border bg-elevated md:size-[4.5rem]",
                  focus
                    ? "border-lime text-offwhite shadow-[0_0_28px_rgba(215,255,100,0.25)]"
                    : "border-line-strong text-offwhite/90",
                ]}
              >
                <Icon aria-hidden="true" class="size-5 md:size-6" stroke-width={1.4} />
              </span>
              <div class="pt-1 md:mt-5 md:pt-0">
                <p class:list={["text-label tabular-nums", focus ? "text-lime" : "text-grey"]}>0{i + 1}</p>
                <p class="mt-1 font-display text-title font-semibold">{label}</p>
                <p class="mt-2 max-w-[13rem] text-small text-grey md:mx-auto">{caption}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <figcaption class="eyebrow relative mt-12 flex items-center justify-center gap-4 text-center">
        <span aria-hidden="true" class="h-px w-8 bg-line-strong"></span>
        A conceptual model for building useful AI systems.
        <span aria-hidden="true" class="h-px w-8 bg-line-strong"></span>
      </figcaption>
    </figure>

    <dl class="reveal mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
      {
        principles.map(({ icon: Icon, ...p }, i) => (
          <div class="group relative isolate flex min-h-40 items-center gap-6 overflow-hidden bg-obsidian p-6 sm:gap-8 sm:p-8">
            <span class="absolute left-6 top-5 text-label font-medium tabular-nums text-lime sm:left-8">0{i + 1}</span>
            <Icon aria-hidden="true" class="mt-4 size-8 shrink-0 text-offwhite sm:ml-6" stroke-width={1.3} />
            <span aria-hidden="true" class="h-16 w-px shrink-0 bg-line-strong" />
            <div class="relative z-10 max-w-[19rem] [text-shadow:0_1px_10px_rgba(17,19,16,0.9)]">
              <dt class="font-display text-title font-semibold">{p.title}</dt>
              <dd class="mt-2 text-body text-grey">{p.body}</dd>
            </div>

            {/* Per-principle illustration on the right edge. */}
            <svg aria-hidden="true" viewBox="0 0 180 160" class="card-art pointer-events-none absolute right-4 top-1/2 -z-10 h-24 w-28 -translate-y-1/2 opacity-60 transition-opacity duration-500 group-hover:opacity-100 lg:opacity-80">
              {p.id === "context" &&
                [70, 40, 10].map((y, k) => (
                  <polygon
                    points={rhombus(y)}
                    fill={k === 0 ? "#d7ff64" : "#f5f5f0"}
                    fill-opacity={k === 0 ? 0.35 : 0.05}
                    stroke={k === 0 ? "#d7ff64" : "#f5f5f0"}
                    stroke-opacity={k === 0 ? 0.9 : 0.4}
                  />
                ))}
              {p.id === "orchestration" && (
                <g fill="none" stroke="#d7ff64">
                  {[0, 1, 2, 3, 4, 5].map((k) => (
                    <path d={`M0 ${70 + k * 4} C 70 ${70 + k * 4}, 110 ${110 - k * 14}, 170 ${20 + k * 18}`} stroke-opacity={0.15 + k * 0.08} />
                  ))}
                  <circle cx="170" cy="20" r="3" fill="#d7ff64" />
                  <circle cx="160" cy="130" r="3" fill="#d7ff64" />
                </g>
              )}
              {p.id === "evaluation" && (
                <g fill="none">
                  <circle cx="110" cy="90" r="62" stroke="#f5f5f0" stroke-opacity="0.12" />
                  <path d="M60 60 A 62 62 0 0 0 80 140" stroke="#d7ff64" stroke-opacity="0.8" stroke-width="1.5" />
                  <circle cx="62" cy="68" r="6" fill="#d7ff64" class="ph-bob" />
                </g>
              )}
              {p.id === "integration" && (
                <g>
                  <circle cx="110" cy="85" r="40" fill="#d7ff64" opacity="0.18" style="filter: blur(10px)" />
                  <polygon points="110,50 145,70 110,90 75,70" fill="#e4ff91" />
                  <polygon points="75,70 110,90 110,130 75,110" fill="#a6d330" />
                  <polygon points="145,70 110,90 110,130 145,110" fill="#7a9e1f" />
                  <polygon points="60,40 80,30 100,40 80,50" fill="none" stroke="#f5f5f0" stroke-opacity="0.25" />
                  <polygon points="140,30 160,20 180,30 160,40" fill="none" stroke="#f5f5f0" stroke-opacity="0.25" />
                </g>
              )}
            </svg>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ph-bob {
      animation: ph-bob 7s ease-in-out infinite;
    }
  }
  @keyframes ph-bob {
    50% { translate: 0 -6px; }
  }
</style>
