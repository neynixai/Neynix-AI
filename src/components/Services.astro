---
import Boxes from "@lucide/astro/icons/boxes";
import FileSearch from "@lucide/astro/icons/file-search";
import Network from "@lucide/astro/icons/network";
import Sparkle from "@lucide/astro/icons/sparkle";
import SectionHeader from "@/components/SectionHeader.astro";
import { services } from "@/lib/content";

const icons = { agents: Network, llm: FileSearch, software: Boxes, products: Sparkle };
---

<section id="services" aria-labelledby="services-title" class="section-pad border-t border-line bg-elevated">
  <div class="container-page">
    <SectionHeader
      id="services-title"
      eyebrow="What we build"
      index="01 — Services"
      lede="From AI-powered workflows to complete applications, we build systems that connect useful intelligence with real business needs."
    >
      <Fragment slot="title">Intelligent software.<br class="hidden sm:block" />{" "}Engineered for real work.</Fragment>
    </SectionHeader>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => {
          const Icon = icons[service.id];
          return (
            <li class="reveal group relative flex flex-col bg-elevated p-6 sm:p-7">
              {/* Hairline that draws across the top on hover. */}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-lime transition-transform duration-500 ease-out group-hover:scale-x-100"
              />
              <div class="flex items-start justify-between">
                <Icon
                  aria-hidden="true"
                  class="size-7 text-offwhite transition-transform duration-300 group-hover:-translate-y-0.5"
                  stroke-width={1.25}
                />
                <span class="text-small font-medium tabular-nums text-grey">{service.number}</span>
              </div>
              <h3 class="mt-10 text-title">{service.title}</h3>
              <p class="mt-3 text-body text-grey">{service.description}</p>
              <ul class="mt-6 space-y-2.5 border-t border-line pt-5">
                {service.capabilities.map((capability) => (
                  <li class="flex items-center gap-3 text-small text-offwhite/80">
                    <span aria-hidden="true" class="size-1 shrink-0 bg-grey" />
                    {capability}
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
