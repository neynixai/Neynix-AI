---
import ChevronRight from "@lucide/astro/icons/chevron-right";

type Props = {
  points: { title: string; body: string }[];
  columns: 3 | 4;
  /** Numbered steps joined by arrows, instead of a plain grid of cards. */
  steps?: boolean;
};

const { points, columns, steps = false } = Astro.props;
---

<ol
  class:list={[
    "grid gap-4",
    steps
      ? "md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)_auto_minmax(0,1fr)] md:items-stretch"
      : ["sm:grid-cols-2", { "lg:grid-cols-3": columns === 3, "lg:grid-cols-4": columns === 4 }],
  ]}
>
  {
    points.map((point, i) => (
      <>
        {steps && i > 0 && (
          <li aria-hidden="true" class="hidden items-center justify-center text-grey md:flex">
            <ChevronRight class="size-5" stroke-width={1.75} />
          </li>
        )}
        <li class="reveal flex flex-col rounded-xl border border-line bg-elevated p-6 transition-colors duration-300 hover:border-line-strong">
          {steps ? (
            <span class="inline-flex size-7 items-center justify-center rounded-md bg-lime text-xs font-semibold text-obsidian">
              {i + 1}
            </span>
          ) : (
            <span aria-hidden="true" class="size-2.5 rounded-sm bg-lime" />
          )}
          <h3 class="mt-5 text-title">{point.title}</h3>
          <p class="mt-3 text-body text-grey">{point.body}</p>
        </li>
      </>
    ))
  }
</ol>
