---
import Bot from "@lucide/astro/icons/bot";
import Cpu from "@lucide/astro/icons/cpu";
import Workflow from "@lucide/astro/icons/workflow";
import ButtonLink from "@/components/ButtonLink.astro";
import LogoMark from "@/components/LogoMark.astro";

const focusAreas = [
  { label: "AI engineering", icon: Cpu },
  { label: "Automation", icon: Workflow },
  { label: "Intelligent software", icon: Bot },
];
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  {/* Backdrop: lime haze and a dot grid that fades out from the mark. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute right-[-10%] top-[10%] size-[44rem] rounded-full bg-lime/[0.07] blur-3xl"></div>
    <div class="absolute -left-40 bottom-0 size-[28rem] rounded-full bg-lime/[0.03] blur-3xl"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(rgba(215,255,100,0.22)_1px,transparent_1px)] [background-size:28px_28px] [mask-image:radial-gradient(ellipse_at_72%_45%,black,transparent_60%)]"
    ></div>
  </div>

  <div
    class="container-page grid items-center gap-12 pb-16 pt-10 sm:pt-14 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:pb-20 lg:pt-6"
  >
    <div class="max-w-xl">
      <p class="flex items-center gap-4 animate-rise">
        <span aria-hidden="true" class="h-0.5 w-10 bg-lime"></span>
        <span class="eyebrow uppercase tracking-[0.16em]">Independent AI engineering studio</span>
      </p>
      <h1 id="hero-title" class="mt-6 text-display animate-rise [animation-delay:80ms]">
        Build what&rsquo;s next{" "}<span class="whitespace-nowrap text-lime">with AI.</span>
      </h1>
      <p class="mt-7 max-w-[34rem] text-lede text-pretty text-grey animate-rise [animation-delay:160ms]">
        NEYNIX AI builds intelligent applications, AI agents, and custom software that help turn complex ideas into
        practical solutions.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row animate-rise [animation-delay:240ms]">
        <ButtonLink href="#contact" arrow class="shadow-[0_0_28px_rgba(215,255,100,0.25)]">Discuss a project</ButtonLink>
        <ButtonLink href="#services" variant="secondary">Explore our capabilities</ButtonLink>
      </div>
      <ul aria-label="Focus areas" class="mt-12 flex flex-wrap gap-2.5 animate-fade [animation-delay:400ms]">
        {
          focusAreas.map(({ label, icon: Icon }) => (
            <li class="inline-flex items-center gap-2.5 rounded-full border border-line-strong bg-obsidian/60 py-1.5 pl-1.5 pr-4 text-small text-offwhite/85 backdrop-blur-sm">
              <span class="grid size-7 place-items-center rounded-full border border-lime/40 text-lime">
                <Icon aria-hidden="true" class="size-3.5" stroke-width={1.75} />
              </span>
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      aria-hidden="true"
      class="relative mx-auto aspect-square w-full max-w-[22rem] animate-fade [animation-delay:150ms] sm:max-w-[30rem] lg:max-w-[36rem]"
    >
      <svg viewBox="0 0 400 400" class="absolute inset-0 size-full" fill="none">
        <defs>
          <linearGradient id="hero-ring" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d7ff64" stop-opacity="0.05" />
            <stop offset="0.55" stop-color="#d7ff64" stop-opacity="0.7" />
            <stop offset="1" stop-color="#d7ff64" stop-opacity="0.1" />
          </linearGradient>
          <radialGradient id="hero-core" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#d7ff64" stop-opacity="0.16" />
            <stop offset="1" stop-color="#d7ff64" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="200" cy="200" r="170" fill="url(#hero-core)" />
        <circle cx="200" cy="200" r="190" stroke="#f5f5f0" stroke-opacity="0.08" stroke-dasharray="2 6" />
        <circle cx="200" cy="200" r="150" stroke="#f5f5f0" stroke-opacity="0.06" />
        <g class="hero-orbit" style="transform-origin: 200px 200px">
          <ellipse cx="200" cy="200" rx="188" ry="74" transform="rotate(-24 200 200)" stroke="url(#hero-ring)" stroke-width="1.2" />
          <circle cx="368" cy="128" r="6" fill="#d7ff64" style="filter: drop-shadow(0 0 6px rgba(215,255,100,0.9))" />
          <circle cx="40" cy="268" r="3.5" fill="#d7ff64" opacity="0.7" />
        </g>
        <line x1="10" y1="200" x2="44" y2="200" stroke="#d7ff64" stroke-opacity="0.5" />
        <circle cx="10" cy="200" r="2.5" fill="#d7ff64" />
      </svg>

      {/* The 3D mark fades in over the flat one once WebGL has drawn a frame. */}
      <div data-mark-3d class="group/mark absolute inset-[4%]">
        <div
          class="absolute inset-y-[16%] left-[10%] right-[22%] flex items-center justify-center transition-opacity duration-700 group-data-[ready]/mark:opacity-0"
        >
          <LogoMark class="h-auto w-full" />
        </div>
        <canvas
          class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [filter:drop-shadow(-8px_4px_24px_rgb(215_255_100/0.22))] group-data-[ready]/mark:opacity-100"
        ></canvas>
      </div>

      <div class="absolute right-0 top-[18%] hidden sm:block">
        <span class="block h-0.5 w-8 bg-lime"></span>
        <ul class="eyebrow mt-4 space-y-1.5 uppercase tracking-[0.16em]">
          <li>Ideas</li>
          <li>Intelligence</li>
          <li>Impact</li>
        </ul>
      </div>
      <span class="eyebrow absolute bottom-[6%] right-[2%] uppercase tracking-[0.16em]">00 / Studio</span>
    </div>
  </div>
</section>

<script>
  import { mountMark3D } from "@/scripts/mark-3d";

  const root = document.querySelector<HTMLElement>("[data-mark-3d]");
  const canvas = root?.querySelector("canvas");
  if (root && canvas) mountMark3D(canvas, () => root.setAttribute("data-ready", ""));
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-orbit {
      animation: hero-orbit 60s linear infinite;
    }
  }
  @keyframes hero-orbit {
    to { rotate: 360deg; }
  }
</style>
