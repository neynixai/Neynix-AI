---
import ButtonLink from "@/components/ButtonLink.astro";
import LogoMark from "@/components/LogoMark.astro";
---

<section aria-labelledby="hero-title" class="relative overflow-hidden">
  <div
    class="container-page grid items-center gap-12 pb-16 pt-10 sm:pt-14 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:pb-20 lg:pt-6"
  >
    <div class="max-w-xl">
      <p class="eyebrow animate-rise">Independent AI engineering studio</p>
      <h1 id="hero-title" class="mt-5 text-display animate-rise [animation-delay:80ms]">
        Build what&rsquo;s next{" "}<span class="whitespace-nowrap">with AI.</span>
      </h1>
      <p class="mt-6 max-w-[34rem] text-lede text-pretty text-grey animate-rise [animation-delay:160ms]">
        NEYNIX AI builds intelligent applications, AI agents, and custom software that help turn complex ideas into
        practical solutions.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row animate-rise [animation-delay:240ms]">
        <ButtonLink href="#contact" arrow>Discuss a project</ButtonLink>
        <ButtonLink href="#services" variant="secondary">Explore our capabilities</ButtonLink>
      </div>
      <ul
        aria-label="Focus areas"
        class="eyebrow mt-12 flex flex-wrap gap-x-5 gap-y-2 animate-fade [animation-delay:400ms]"
      >
        {
          ["AI engineering", "Automation", "Intelligent software"].map((item) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="size-1 bg-grey" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      aria-hidden="true"
      class="relative mx-auto aspect-square w-full max-w-[22rem] animate-fade [animation-delay:150ms] sm:max-w-[30rem] lg:max-w-[36rem]"
    >
      <svg viewBox="0 0 400 400" class="absolute inset-0 size-full text-offwhite" fill="none">
        <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-opacity="0.07"></circle>
        <circle cx="200" cy="200" r="190" stroke="currentColor" stroke-opacity="0.05" stroke-dasharray="2 6"></circle>
        <line x1="10" y1="200" x2="44" y2="200" stroke="currentColor" stroke-opacity="0.35"></line>
        <circle cx="10" cy="200" r="2" fill="currentColor"></circle>
        <circle cx="34" cy="200" r="1.5" fill="currentColor" fill-opacity="0.5"></circle>
        <line x1="300" y1="352" x2="372" y2="352" stroke="currentColor" stroke-opacity="0.25"></line>
      </svg>

      {/* The 3D mark fades in over the flat one once WebGL has drawn a frame. */}
      <div data-mark-3d class="group/mark absolute inset-[4%]">
        <div
          class="absolute inset-y-[16%] left-[10%] right-[22%] flex items-center justify-center transition-opacity duration-700 group-data-[ready]/mark:opacity-0"
        >
          <LogoMark class="h-auto w-full" />
        </div>
        <canvas
          class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [filter:drop-shadow(-8px_4px_16px_rgb(215_255_100/0.14))] group-data-[ready]/mark:opacity-100"
        ></canvas>
      </div>

      <div
        class="absolute right-0 top-[24%] hidden border-l border-line-strong pl-3 text-xs leading-relaxed text-grey sm:block"
      >
        Ideas<br />Intelligence<br />Impact
      </div>
      <span class="absolute bottom-[9%] right-[4%] text-xs tabular-nums text-grey">01</span>
    </div>
  </div>
</section>

<script>
  import { mountMark3D } from "@/scripts/mark-3d";

  const root = document.querySelector<HTMLElement>("[data-mark-3d]");
  const canvas = root?.querySelector("canvas");
  if (root && canvas) mountMark3D(canvas, () => root.setAttribute("data-ready", ""));
</script>
