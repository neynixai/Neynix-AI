---
import { statuses, type ProjectStatus } from "@/lib/projects";

type Props = { status: ProjectStatus };

const { status } = Astro.props;
---

<span
  class="inline-flex items-center gap-2 rounded-full border border-line bg-obsidian px-3 py-1 text-xs font-medium text-offwhite/80"
>
  <span aria-hidden="true" class:list={["size-1.5 rounded-full", statuses[status].dot]}></span>
  <span class="sr-only">Status: </span>
  {statuses[status].label}
</span>
