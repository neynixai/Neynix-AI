# Copy to .env.local and fill in real values. Leave a value empty to hide
# the related link or feature — the site never shows invented contact details.
# For GitHub Pages, set these as repository Variables (Settings → Secrets and
# variables → Actions → Variables); the deploy workflow passes them to the build.

# Production origin, e.g. https://neynix.ai. On GitHub Pages the workflow sets
# this automatically to the Pages URL unless you override it.
NEXT_PUBLIC_SITE_URL=

# Public contact links (shown in the contact section and footer when set).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Contact form delivery. The site is static, so messages go to an external
# form service that accepts a JSON POST, e.g. a Formspree form URL:
# https://formspree.io/f/xxxxxxx — the form is only shown when this is set.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
