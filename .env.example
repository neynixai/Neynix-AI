# Copy to .env.local and fill in real values. Leave a value empty to hide
# the related link or feature — the site never shows invented contact details.
# For GitHub Pages, set these as repository Variables (Settings → Secrets and
# variables → Actions → Variables); the deploy workflow passes them to the build.

# Production origin, e.g. https://neynix.ai. On GitHub Pages the workflow sets
# this automatically to the Pages URL unless you override it.
PUBLIC_SITE_URL=

# Public contact links (shown in the contact section and footer when set).
PUBLIC_CONTACT_EMAIL=
PUBLIC_LINKEDIN_URL=
PUBLIC_GITHUB_URL=

# Contact form delivery. The site is static, so messages go to Web3Forms:
# create a free access key at https://web3forms.com (it is emailed to the
# address that should receive enquiries). The key is public by design. The
# form is only shown when this is set.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Site assistant: the chatbot Worker's widget script, e.g.
# https://neynix-chatbot.<account>.workers.dev/widget.js — hidden when empty.
# Locally, `npm run dev` in chatbot/ serves it at http://localhost:8787/widget.js
PUBLIC_CHAT_WIDGET_URL=

# Google Search Console: the content="…" value of the HTML-tag verification
# method (Search Console → Add property → URL prefix → HTML tag).
PUBLIC_GOOGLE_SITE_VERIFICATION=
